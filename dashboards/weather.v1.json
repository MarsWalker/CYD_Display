{
  "TIMEZONE": "Europe/Lisbon",
  "Cores": 2,
  "touchEnable": true,
  "Log": {
    "Weather": true,
    "HA": false,
    "DHT": false
  },
  "DataSources": [
    {
      "Type": "Weather",
      "Id": "weather_local",
      "Refresh": 900000,
      "url": "https://api.open-meteo.com/v1/forecast?latitude=41.343&longitude=-8.477&current=temperature_2m,relative_humidity_2m,pressure_msl,weather_code,is_day&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=Europe%2FLisbon&forecast_days=7",
      "Map": {
        "temperature": "current.temperature_2m",
        "humidity": "current.relative_humidity_2m",
        "pressure": "current.pressure_msl",
        "code": "current.weather_code"
      }
    }
  ],
  "Screens": [
    {
      "Number": 1,
      "Rotation": 0,
      "Invert": true,
      "Refresh": 1000,
      "Objects": [
        {
          "Type": "DrawWeatherPanel",
          "Source": "weather_local",
          "Theme": {
            "BackgroundTop": "#080F20",
            "BackgroundBottom": "#101D38",
            "Card": "#101B30",
            "Text": "#FFFFFF",
            "SecondaryText": "#D0E0F8",
            "Divider": "#263954",
            "Offline": "#708098"
          },
          "Layout": {
            "DateX": 12,
            "DateY": 9,
            "IconX": 10,
            "IconY": 31,
            "TemperatureY": 45,
            "DescriptionY": 103,
            "MetricsY": 121,
            "ForecastY": 140,
            "RowHeight": 22,
            "FooterY": 307
          },
          "Fonts": {
            "Date": 2,
            "Temperature": 6,
            "Description": 1,
            "Metrics": 1,
            "Forecast": 2
          }
        }
      ]
    }
  ],
  "IdleBrightness": {
    "Timeout": 60,
    "Normal": 100,
    "Dim": 20,
    "ActiveStart": "23:00",
    "ActiveEnd": "07:00"
  }
}
